PORT=1234
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/cravyo
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# MySQL stores credentials; MongoDB mirror IDs connect identities to domain data.
AUTH_DATABASE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cravyo
MYSQL_PASSWORD=
MYSQL_DATABASE=cravyo
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=300

ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=cravyo-products

# Reconcile MongoDB counters, Redis state, and Elasticsearch every five minutes.
SYNC_CRON=*/5 * * * *
INFRASTRUCTURE_REQUIRED=true
